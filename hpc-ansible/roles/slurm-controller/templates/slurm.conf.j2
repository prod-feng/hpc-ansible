# Slurm configuration generated by Ansible


ClusterName={{ slurm_cluster_name }}


SlurmctldHost={{ slurm_controller_host }}


SlurmctldPort={{ slurm_port }}


AuthType=auth/munge


SlurmUser={{ slurm_user }}


StateSaveLocation=/var/spool/slurmctld


SlurmdSpoolDir=/var/spool/slurmd


SwitchType=switch/none


MpiDefault=none


ProctrackType=proctrack/cgroup


TaskPlugin=task/cgroup


SelectType=select/cons_tres
GresTypes=gpu

SelectTypeParameters=CR_Core_Memory



{% for node in groups['compute'] %}

NodeName={{ node }} CPUs={{ hostvars[node].ansible_processor_vcpus | default(64) }} RealMemory={{ slurm_compute_default_memory }}

{% endfor %}


{% for node in groups['gpu'] %}

NodeName={{ node }} CPUs={{ hostvars[node].ansible_processor_vcpus | default(64) }} RealMemory={{ hostvars[node].ansible_memtotal_mb | default(256000) }} Gres=gpu:{{ gres_count | default(8) }}

{% endfor %}

PartitionName={{ slurm_compute_partition }} Nodes=ALL Default=YES State=UP


ReturnToService=2


SlurmctldDebug=info


SlurmdDebug=info

CommunicationParameters=NoAddrCache
MessageTimeout=30
MpiDefault=pmix

